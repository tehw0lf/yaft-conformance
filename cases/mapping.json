{
  "suite": "mapping",
  "version": 4,
  "cases": [
    {
      "name": "toggles-lowercase",
      "rules": [
        "R22",
        "R22a"
      ],
      "why": "What backend 0.1.7 and later return for a UUID group: the same lowercase spelling as a single toggle. The capitalised variant in toggles-capitalised is the legacy shape a port must still accept.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": "true",
            "activeAt": null,
            "disabledAt": null,
            "tags": [
              "beta"
            ]
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      }
    },
    {
      "name": "toggles-capitalised",
      "rules": [
        "R22",
        "R22a"
      ],
      "why": "A UUID group comes back under toggles with capitalised names, because the backend DTO carries no JSON tags.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Key": "uuid|a",
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": null,
            "Tags": [
              "beta"
            ]
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      }
    },
    {
      "name": "value-collection-key",
      "rules": [
        "R22"
      ],
      "why": "Some responses carry the collection under value instead of toggles; both must be read the same way.",
      "shape": "feature",
      "response": {
        "value": [
          {
            "Key": "uuid|a",
            "Value": "false",
            "ActiveAt": null,
            "DisabledAt": null,
            "Tags": []
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "single-toggle-lowercase",
      "rules": [
        "R22",
        "R22a"
      ],
      "why": "A single toggle comes back flat and lowercase -- the other of the two shapes a port must read.",
      "shape": "feature",
      "response": {
        "key": "uuid|a",
        "value": "true",
        "activeAt": "2026-09-18T10:00:00Z",
        "disabledAt": "2026-09-18T14:00:00Z",
        "tags": [
          "beta",
          "internal"
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "2026-09-18T10:00:00Z",
          "disabledAt": "2026-09-18T14:00:00Z",
          "tags": [
            "beta",
            "internal"
          ]
        }
      }
    },
    {
      "name": "mixed-casing-in-one-collection",
      "rules": [
        "R22",
        "R22a"
      ],
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Key": "uuid|a",
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": null
          },
          {
            "key": "uuid|b",
            "value": "false",
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "empty-value-not-replaced",
      "rules": [
        "R23"
      ],
      "why": "The heart of the presence rule. A lowercase value of \"\" is present and must win; an or-style choice would skip past it to the capitalised field and report \"true\", turning an off feature on.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": "",
            "Value": "true",
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "empty-tags-not-replaced",
      "rules": [
        "R23"
      ],
      "why": "The same trap for arrays: an empty tags list is a real answer, not a missing one.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": "true",
            "tags": [],
            "Tags": [
              "beta"
            ],
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "null-and-empty-dates-equivalent",
      "rules": [
        "R24"
      ],
      "why": "The backend sends null, local fixtures send \"\". Both normalise to no bound.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Key": "uuid|a",
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": ""
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "absent-date-fields",
      "rules": [
        "R24"
      ],
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Key": "uuid|a",
            "Value": "true"
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "absent-tags-default-to-empty",
      "rules": [
        "R22"
      ],
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Key": "uuid|a",
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "entry-without-key-skipped",
      "rules": [
        "R25"
      ],
      "why": "Storing it under an empty key would make it reachable by isEnabled(\"\").",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": null
          },
          {
            "Key": "uuid|a",
            "Value": "true",
            "ActiveAt": null,
            "DisabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "value-boolean-not-coerced",
      "rules": [
        "R33"
      ],
      "why": "The boolean shape is where JSON booleans belong. In the feature shape value is a string, so true is not set and the feature is off, not \"true\".",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": true,
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "value-number-not-coerced",
      "rules": [
        "R33"
      ],
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": 1,
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "non-string-value-does-not-fall-through",
      "rules": [
        "R33",
        "R23"
      ],
      "why": "The lowercase value is present, so it wins (R23) -- and being no string, it is not set. Falling through to the capitalised \"true\" would turn the feature on.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": "uuid|a",
            "value": true,
            "Value": "true",
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "key-not-a-string-skipped",
      "rules": [
        "R33",
        "R25"
      ],
      "why": "A number is no key. Written out, it would be \"7\" in one port and \"7.0\" in another, depending on the JSON library.",
      "shape": "feature",
      "response": {
        "toggles": [
          {
            "key": 7,
            "value": "true",
            "activeAt": null,
            "disabledAt": null
          },
          {
            "key": "uuid|a",
            "value": "true",
            "activeAt": null,
            "disabledAt": null
          }
        ]
      },
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "empty-collection",
      "rules": [
        "R22"
      ],
      "shape": "feature",
      "response": {
        "toggles": []
      },
      "expected": {}
    },
    {
      "name": "empty-group-replaces-held",
      "rules": [
        "R30",
        "R22",
        "R32"
      ],
      "why": "What the backend answers once a group's last toggle is deleted (R31). It is a group, so it replaces the held data and every toggle is off. A port that treats it as a failure keeps the deleted toggle on forever.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": false,
      "response": {
        "toggles": []
      },
      "expected": {}
    },
    {
      "name": "empty-value-collection-replaces-held",
      "rules": [
        "R30",
        "R22",
        "R32"
      ],
      "why": "The same under the value envelope, which R22 treats identically.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": false,
      "response": {
        "value": []
      },
      "expected": {}
    },
    {
      "name": "group-replaces-held-without-merging",
      "rules": [
        "R30",
        "R32"
      ],
      "why": "uuid|a was deleted in the backend. Merging the new group into the held data would keep it on.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": false,
      "response": {
        "toggles": [
          {
            "key": "uuid|b",
            "value": "true",
            "activeAt": null,
            "disabledAt": null,
            "tags": []
          }
        ]
      },
      "expected": {
        "uuid|b": {
          "key": "uuid|b",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "single-toggle-replaces-held",
      "rules": [
        "R30",
        "R22",
        "R32"
      ],
      "why": "A single toggle is a group of one; it replaces the held data like a collection does.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": false,
      "response": {
        "key": "uuid|b",
        "value": "true"
      },
      "expected": {
        "uuid|b": {
          "key": "uuid|b",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "skipped-entry-still-replaces-held",
      "rules": [
        "R30",
        "R25",
        "R32"
      ],
      "why": "One unusable entry next to a usable one is skipped (R25); the body is still a group and replaces the held data.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": false,
      "response": {
        "toggles": [
          null,
          {
            "key": "uuid|b",
            "value": "true"
          }
        ]
      },
      "expected": {
        "uuid|b": {
          "key": "uuid|b",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        }
      }
    },
    {
      "name": "null-body-keeps-held",
      "rules": [
        "R30",
        "R32"
      ],
      "why": "null normalises to nothing. Storing that would switch every feature off without an error. The retry under the same hash must then load: a port that recorded the hash on the rejected body would never refresh again.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": true,
      "response": null,
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "retry": {
        "response": {
          "toggles": []
        },
        "expected": {}
      }
    },
    {
      "name": "array-body-keeps-held",
      "rules": [
        "R30",
        "R32"
      ],
      "why": "A bare array is no envelope, however empty it is. Only {\"toggles\": []} is an empty group. The retry under the same hash must then load: a port that recorded the hash on the rejected body would never refresh again.",
      "shape": "feature",
      "held": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "rejected": true,
      "response": [],
      "expected": {
        "uuid|a": {
          "key": "uuid|a",
          "value": "true",
          "activeAt": "",
          "disabledAt": "",
          "tags": []
        },
        "uuid|b": {
          "key": "uuid|b",
          "value": "false",
          "activeAt": "",
          "disabledAt": "",
          "tags": [
            "beta"
          ]
        }
      },
      "retry": {
        "response": {
          "toggles": []
        },
        "expected": {}
      }
    },
