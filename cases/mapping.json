    {
      "name": "boolean-shape-true",
      "rules": [
        "R21"
      ],
      "why": "The boolean shape maps straight onto isEnabled and has no time logic at all.",
      "shape": "boolean",
      "response": {
        "myToggle": true
      },
      "expected": {
        "myToggle": true
      },
      "isEnabled": {
        "myToggle": true
      }
    },
    {
      "name": "boolean-shape-false",
      "rules": [
        "R21"
      ],
      "shape": "boolean",
      "response": {
        "myToggle": false
      },
      "expected": {
        "myToggle": false
      },
      "isEnabled": {
        "myToggle": false
