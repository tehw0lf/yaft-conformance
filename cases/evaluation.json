{
  "suite": "evaluation",
  "version": 1,
  "cases": [
    {
      "name": "missing-key",
      "rules": ["R3"],
      "now": "2026-09-18T12:00:00Z",
      "features": {},
      "key": "absent",
      "expected": false
    },
    {
      "name": "null-feature",
      "rules": ["R3"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": null },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-true",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "value-false",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "false", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-uppercase",
      "rules": ["R4"],
      "why": "Comparison is exact and case-sensitive.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "TRUE", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-capitalised",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "True", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-one",
      "rules": ["R4"],
      "why": "A port that coerces the string to a boolean would read this as on.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "1", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-yes",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "yes", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-empty",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-padded",
      "rules": ["R4"],
      "why": "No trimming: the backend stores exactly what it was given.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": " true", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "value-absent",
      "rules": ["R4"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "active-at-future",
      "rules": ["R5"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T13:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "active-at-past",
      "rules": ["R5"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T11:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "active-at-boundary",
      "rules": ["R5"],
      "why": "The comparison is now < activeAt, so the boundary itself is on.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T12:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "active-at-boundary-minus-one-ms",
      "rules": ["R5"],
      "why": "One millisecond before the boundary is still off; pins the comparison down to sub-second resolution.",
      "now": "2026-09-18T11:59:59.999Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T12:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "disabled-at-future",
      "rules": ["R6"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T13:00:00Z" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "disabled-at-past",
      "rules": ["R6"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T11:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "disabled-at-boundary",
      "rules": ["R6"],
      "why": "The comparison is now >= disabledAt, so the boundary is off -- the opposite of activeAt.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "disabled-at-boundary-minus-one-ms",
      "rules": ["R6"],
      "now": "2026-09-18T11:59:59.999Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00Z" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "window-inside",
      "rules": ["R5", "R6"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T10:00:00Z", "disabledAt": "2026-09-18T14:00:00Z" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "window-before",
      "rules": ["R5", "R6"],
      "now": "2026-09-18T09:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T10:00:00Z", "disabledAt": "2026-09-18T14:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "window-after",
      "rules": ["R5", "R6"],
      "now": "2026-09-18T15:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T10:00:00Z", "disabledAt": "2026-09-18T14:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "window-off-value-inside",
      "rules": ["R4", "R5", "R6"],
      "why": "A window never overrides the value; an off feature stays off inside it.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "false", "activeAt": "2026-09-18T10:00:00Z", "disabledAt": "2026-09-18T14:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "inverted-window-before",
      "rules": ["R7"],
      "why": "activeAt after disabledAt is evaluated as written, never swapped; the window is never open.",
      "now": "2026-09-18T09:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T14:00:00Z", "disabledAt": "2026-09-18T10:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "inverted-window-between",
      "rules": ["R7"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T14:00:00Z", "disabledAt": "2026-09-18T10:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "inverted-window-after",
      "rules": ["R7"],
      "now": "2026-09-18T16:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T14:00:00Z", "disabledAt": "2026-09-18T10:00:00Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-positive",
      "rules": ["R13"],
      "why": "14:00+02:00 is 12:00Z, which is exactly now, so the inclusive activeAt boundary applies.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T14:00:00+02:00", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "offset-negative",
      "rules": ["R13"],
      "why": "08:00-05:00 is 13:00Z, an hour after now, so it is not active yet.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T08:00:00-05:00", "disabledAt": "" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-crosses-date-line",
      "rules": ["R13"],
      "why": "2026-09-19T01:00:00+14:00 is 2026-09-18T11:00:00Z -- a later calendar date that is an earlier instant. A port that compared dates textually would get this wrong.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-19T01:00:00+14:00", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "now-with-offset",
      "rules": ["R13"],
      "why": "The case's own now carries an offset, so an adapter that mis-parses it fails here rather than silently everywhere.",
      "now": "2026-09-18T14:00:00+02:00",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T12:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "lowercase-t-and-z",
      "rules": ["R10"],
      "why": "RFC 3339 permits lowercase separators.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18t11:00:00z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "fractional-seconds",
      "rules": ["R10"],
      "why": "One millisecond after now, so an accepted bound leaves the feature on; a rejected one would too, hence the tighter check in fractional-seconds-decides.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00.001Z" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "fractional-seconds-decides",
      "rules": ["R10"],
      "why": "Here the fraction is what flips the answer: ignoring it would drop the bound and report on.",
      "now": "2026-09-18T12:00:00.500Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00.100Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "fractional-sub-millisecond-disabled-at",
      "rules": ["R27", "R6"],
      "why": "Truncated, the bound is exactly now and the feature is off (R6). Kept at full precision or rounded up, it lies after now and the feature stays on.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00.0009Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "fractional-sub-millisecond-active-at",
      "rules": ["R27", "R5"],
      "why": "The mirror image: truncated, activeAt is exactly now and the feature is on (R5). Kept at full precision, it lies after now and the feature is off.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T12:00:00.0009Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "fractional-truncated-not-rounded",
      "rules": ["R27"],
      "why": "Rounded, .9999999 becomes 12:00:01 and the feature is not active yet. Truncated, it is .999, which is now.",
      "now": "2026-09-18T12:00:00.999Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2026-09-18T12:00:00.9999999Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "fractional-more-than-nine-digits",
      "rules": ["R27", "R10"],
      "why": "Twelve digits. A parser capped at nanoseconds rejects this and drops the bound, leaving the feature on; truncated it is .123, which is now, so the feature is off.",
      "now": "2026-09-18T12:00:00.123Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00.123456789123Z" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-beyond-eighteen-hours",
      "rules": ["R28", "R13"],
      "why": "+20:00 puts this bound at 2026-09-18T00:00:00Z, twelve hours before now. A date library limited to ±18:00 rejects it and leaves the feature on.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T20:00:00+20:00" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-largest-negative",
      "rules": ["R28", "R13"],
      "why": "-23:59 is the largest offset allowed and puts this bound exactly at now, so the feature is off (R6).",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-17T12:01:00-23:59" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-negative-zero",
      "rules": ["R28"],
      "why": "-00:00 is RFC 3339's unknown local offset and names the same instant as Z.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "2026-09-18T12:00:00-00:00" } },
      "key": "f",
      "expected": false
    },
    {
      "name": "offset-hour-24-ignored",
      "rules": ["R28", "R8"],
      "why": "Hour 24 is out of range, so the bound is ignored and the feature is on. Accepted, it would be a bound in 2099 and the feature off.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18T12:00:00+24:00", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "offset-minute-60-ignored",
      "rules": ["R28", "R8"],
      "why": "Minute 60 is out of range; the same reasoning as offset-hour-24-ignored.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18T12:00:00+02:60", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "bounds-empty-string",
      "rules": ["R2", "R8"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "bounds-null",
      "rules": ["R2", "R8"],
      "why": "The backend sends null for an unset date; a local fixture sends \"\". They must behave alike.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": null, "disabledAt": null } },
      "key": "f",
      "expected": true
    },
    {
      "name": "bounds-absent",
      "rules": ["R2", "R8"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-bare-date",
      "rules": ["R8", "R10"],
      "why": "A bare date is read as UTC midnight by JavaScript and as local midnight elsewhere. Ignored, so the feature stays on -- a port that accepted it as a future bound would report off.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-no-offset",
      "rules": ["R8", "R10"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18T15:00:00", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-garbage",
      "rules": ["R8", "R10"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "not-a-date", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-unix-timestamp",
      "rules": ["R8", "R10"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "4102444800", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-slash-date",
      "rules": ["R8", "R10"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099/09/18", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-space-separator",
      "rules": ["R8", "R10"],
      "why": "SQL-style separator; RFC 3339 allows it as an option, this spec does not.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18 15:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-offset-without-colon",
      "rules": ["R8", "R10"],
      "why": "+0200 is ISO 8601 basic format, not RFC 3339.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-09-18T15:00:00+0200", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "invalid-both-bounds-garbage",
      "rules": ["R8"],
      "why": "Two unusable bounds must be ignored rather than throw.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "x", "disabledAt": "y" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-february-30",
      "rules": ["R11"],
      "why": "A permissive parser rolls 2099-02-30 forward to March 2 instead of rejecting it. The date is deliberately in the future: a past rollover would let the activeAt check pass for the wrong reason.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-02-30T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-april-31",
      "rules": ["R11"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-04-31T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-month-13",
      "rules": ["R11"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-13-01T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-day-zero",
      "rules": ["R11"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-01-00T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-february-29-non-leap",
      "rules": ["R11"],
      "why": "2099 is not a leap year.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-02-29T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-century-non-leap",
      "rules": ["R11"],
      "why": "2100 is divisible by 4 but not a leap year, because it is a century that is not divisible by 400. A port using only the %4 rule accepts this and shifts the bound by a day.",
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2100-02-29T00:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-hour-24",
      "rules": ["R11"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-01-01T24:00:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
      "name": "rollover-minute-60",
      "rules": ["R11"],
      "now": "2026-09-18T12:00:00Z",
      "features": { "f": { "key": "f", "value": "true", "activeAt": "2099-01-01T00:60:00Z", "disabledAt": "" } },
      "key": "f",
      "expected": true
    },
    {
