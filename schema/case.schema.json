{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehw0lf/yaft-conformance/schema/case.schema.json",
  "title": "YaFT conformance case file",
  "type": "object",
  "required": [
    "suite",
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "suite": {
      "enum": [
        "evaluation",
        "decorator",
        "mapping"
      ],
      "description": "Which case file this is. The adapter dispatches on it."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version of the case file, bumped when the shape of a case changes. An adapter MUST reject a format version it does not know, so a new field can never be silently ignored."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "string",
      "pattern": "^R[0-9]+[a-z]?$",
      "description": "The SPEC.md rule this case pins down."
    },
    "feature": {
      "description": "A feature record. Fields may be absent, null or empty on purpose; that is what several cases test.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "A string, except in cases that check a value of another JSON type is not set (R33)."
        },
        "activeAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "disabledAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "suite": {
          "const": "evaluation"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rules",
              "now",
              "features",
              "key",
              "expected"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/rule"
                }
              },
              "why": {
                "type": "string"
              },
              "now": {
                "type": "string",
                "description": "The instant to evaluate at. Always RFC 3339 with offset, and always valid — an invalid now would make the case untestable."
              },
              "features": {
                "type": "object",
                "description": "The provider's data, keyed by feature key.",
                "additionalProperties": {
                  "$ref": "#/$defs/feature"
                }
              },
              "key": {
                "type": "string",
                "description": "The key to evaluate. May be absent from features on purpose."
              },
              "expected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "suite": {
          "const": "decorator"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rules",
              "target",
              "toggle",
              "fallback",
              "expected"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/rule"
                }
              },
              "why": {
                "type": "string"
              },
              "target": {
                "enum": [
                  "class",
                  "method",
                  "async-method"
                ],
                "description": "What is decorated."
              },
              "toggle": {
                "enum": [
                  "on",
                  "off",
                  "on-then-off",
                  "off-then-on",
                  "no-provider"
                ],
                "description": "The toggle state. The two two-phase values change the toggle after decoration and before the call, which is how R14 and R15 are told apart."
              },
              "fallback": {
                "enum": [
                  "none",
                  "class",
                  "method"
                ],
                "description": "Which kind of fallback is supplied, if any."
              },
              "expected": {
                "enum": [
                  "original",
                  "fallback",
                  "nothing",
                  "resolved-nothing",
                  "empty-shell",
                  "decoration-error"
                ],
                "description": "The outcome the adapter asserts, expressed in port-neutral terms. 'nothing' is undefined/null/None/zero value; 'resolved-nothing' is an already-resolved promise of it."
              },
              "assertions": {
                "type": "array",
                "items": {
                  "enum": [
                    "same-arguments",
                    "same-receiver"
                  ]
                },
                "description": "Extra properties the adapter must check on a fallback invocation."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "suite": {
          "const": "mapping"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rules",
              "shape",
              "response",
              "expected"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/rule"
                }
              },
              "why": {
                "type": "string"
              },
              "shape": {
                "enum": [
                  "feature",
                  "boolean"
                ],
                "description": "Which provider shape consumes this response."
              },
              "response": {
                "description": "The raw payload as the backend or a local fixture delivers it. Any JSON value: a body that is not a group (null, an array, a string) is exactly what several R30 cases test.",
                "type": [
                  "object",
                  "array",
                  "null",
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "held": {
                "type": "object",
                "description": "Feature shape only: the data the provider holds before this response arrives, as normalised feature records keyed by feature key. When present, the adapter loads it through the port's own refresh, then delivers response as the next refresh, and asserts expected -- which for a body that is not a group is held unchanged (R30). When absent, response is simply normalised.",
                "additionalProperties": {
                  "$ref": "#/$defs/feature"
                }
              },
              "rejected": {
                "type": "boolean",
                "description": "Refresh cases only: whether the port must reject response (R30). An adapter whose port reports the refresh outcome asserts it: a failure when true, a success when false (R32). The retry, if any, must always succeed."
              },
              "expected": {
                "type": "object",
                "description": "The normalised data the provider must hold afterwards, keyed by feature key. For the boolean shape the values are booleans; for the feature shape they are normalised feature records with null/empty dates written as \"\".",
                "additionalProperties": true
              },
              "retry": {
                "type": "object",
                "required": [
                  "response",
                  "expected"
                ],
                "additionalProperties": false,
                "description": "Refresh cases only: a further response the stub backend serves after response, under the same collection hash, and the data the provider must hold after refreshing once more. Checks that a rejected refresh does not record the hash, which would block every later refresh until the backend changed again (R30).",
                "properties": {
                  "response": {
                    "description": "As response.",
                    "type": [
                      "object",
                      "array",
                      "null",
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "expected": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              },
              "isEnabled": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                },
                "description": "Boolean shape only: keys to ask isEnabled for and the answer each must give, including keys absent from the response."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "boolean"
                    }
                  }
                },
                "then": {
                  "required": [
                    "isEnabled"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "isEnabled"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "boolean"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "held"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "retry"
                  ]
                },
                "then": {
                  "required": [
                    "held"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "held"
                  ]
                },
                "then": {
                  "required": [
                    "rejected"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "rejected"
                  ]
                },
                "then": {
                  "required": [
                    "held"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
